# ============================================================================
# VERCEL SEPARATE DEPLOYMENT ENVIRONMENT VARIABLES
# ============================================================================

# 1. Deployment Mode ('portfolio' | 'admin' | 'both')
# - Set VITE_APP_MODE=portfolio on your Public Portfolio Vercel project
# - Set VITE_APP_MODE=admin on your Admin Dashboard Vercel project
# - Leave unset or 'both' for local development / unified single deployment
VITE_APP_MODE=both

# 2. Backend API Base URL
# - Leave empty if using the built-in Vercel Serverless API (/api/*) on the same project
# - Or set to your shared Backend URL (e.g. https://sachin-portfolio.vercel.app or Render/Railway URL)
#   so both Portfolio Frontend and Admin Frontend read/write to the exact same backend & database
VITE_API_BASE_URL=

# 3. Public Portfolio URL (Optional - used by standalone Admin project's "View Live Portfolio" button)
VITE_PORTFOLIO_PUBLIC_URL=

# 4. MongoDB Atlas Connection String (Required on Vercel for persistent cloud database storage)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sachin_portfolio_db?retryWrites=true&w=majority
